---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const zoneByDiscipline = {
  "krav-maga": "Jauh dan berdiri",
  judo: "Clinch",
  gulat: "Clinch",
  bjj: "Tanah",
} as const;

const profiles = (
  await getCollection("artikel", ({ data }) => data.type === "aliran")
).sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
---

<BaseLayout
  title="Aliran"
  description="Empat aliran yang dipakai TAHAN, menurut kekuatan dan batasnya."
>
  <header class="page-head">
    <div class="wrap">
      <div class="page-head__top">
        <p class="label">Aliran</p>
        <p class="label">4 profil</p>
      </div>
      <h1>Empat aliran</h1>
      <p class="page-head__lede">
        Krav Maga, Judo, gulat, dan BJJ. Dipakai sesuai kekuatannya, bukan
        sebagai pemenang. Setiap profil menjelaskan asal, asumsi, dan batas
        yang tidak boleh dilewati.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <ul class="discipline-list">
        {
          profiles.map((profile) => {
            const d = profile.data;
            const zone = d.discipline
              ? zoneByDiscipline[d.discipline]
              : "Lintas jarak";
            return (
              <li>
                <a href={`/aliran/${d.slug}`}>
                  <span class="label">{zone}</span>
                  <strong>{d.title.split(":")[0]}</strong>
                  <span>{d.dek}</span>
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .discipline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .discipline-list a {
    display: block;
    padding: 1rem;
    border: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }
  .discipline-list a:hover {
    border-color: var(--accent);
  }
  .discipline-list strong {
    display: block;
    font-family: var(--font-display);
    font-size: 1.4rem;
    margin: 0.25rem 0;
  }
  .discipline-list .label {
    color: var(--accent-dark);
    font-size: 0.625rem;
  }
  .discipline-list span:not(.label) {
    color: var(--muted);
    font-size: 0.95rem;
  }
</style>
