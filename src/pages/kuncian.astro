              <td>Siku lurus, tekanan terasa</td>
            </tr>
            <tr>
              <td>Triangle</td>
              <td>Pembuluh darah leher</td>
              <td>Tekanan di leher, pandangan gelap</td>
            </tr>
            <tr>
