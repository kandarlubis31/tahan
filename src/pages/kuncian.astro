              <th>Tanda tap</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>RNC</td>
              <td>Pembuluh darah leher</td>
              <td>Pusing, penglihatan berkurang</td>
            </tr>
            <tr>
              <td>Armbar</td>
