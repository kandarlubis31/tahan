---
import Figure from "../Figure.astro";

interface Props {
  frame: 1 | 2 | 3;
  number: string;
  alt: string;
  caption: string;
}

const { frame, number, alt, caption } = Astro.props;
const titleId = `block360-figure-${frame}`;
---

<Figure number={number} caption={caption}>
  {
    frame === 1 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          01 / SERANGAN DATANG
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK ATAS
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="320" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="296"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M296 240 L250 260 L210 270" />
        <path class="diagram__main-limb" d="M344 240 L390 260 L430 270" />
        <path class="diagram__main-limb" d="M308 288 L290 320 L270 330" />
        <path class="diagram__main-limb" d="M332 288 L350 320 L370 330" />

        <circle class="diagram__opp" cx="470" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="446"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M446 240 L400 260 L360 270" />
        <path class="diagram__opp-limb" d="M494 240 L540 260 L580 270" />
        <path class="diagram__opp-limb" d="M458 288 L440 320 L420 330" />
        <path class="diagram__opp-limb" d="M482 288 L500 320 L520 330" />

        <path
          class="diagram__arrow"
          d="M446 240 C400 220 360 200 344 200"
          marker-end={`url(#block360-arrow-${frame})`}
        />
        <defs>
          <marker
            id={`block360-arrow-${frame}`}
            viewBox="0 0 6 6"
            refX="5"
            refY="3"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
            markerUnits="strokeWidth"
          >
            <path class="diagram__arrow-head" d="M0 0 L6 3 L0 6 Z" />
          </marker>
        </defs>

        <text x="320" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="470" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="400" y="160" class="diagram__label diagram__label--accent">
          SERANG
        </text>
      </svg>
    )
  }

  {
    frame === 2 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          02 / TANGKISAN 360
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK ATAS
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="320" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="296"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M296 240 L250 260 L210 270" />
        <path class="diagram__main-limb" d="M344 240 L390 260 L430 270" />
        <path class="diagram__main-limb" d="M308 288 L290 320 L270 330" />
        <path class="diagram__main-limb" d="M332 288 L350 320 L370 330" />

        <path
          class="diagram__arrow"
          d="M344 200 C380 150 320 120 280 160"
          marker-end={`url(#block360-arrow-${frame})`}
        />
        <defs>
          <marker
            id={`block360-arrow-${frame}`}
            viewBox="0 0 6 6"
            refX="5"
            refY="3"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
            markerUnits="strokeWidth"
          >
            <path class="diagram__arrow-head" d="M0 0 L6 3 L0 6 Z" />
          </marker>
        </defs>

        <circle class="diagram__opp" cx="470" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="446"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M446 240 L400 260 L360 270" />
        <path class="diagram__opp-limb" d="M494 240 L540 260 L580 270" />
        <path class="diagram__opp-limb" d="M458 288 L440 320 L420 330" />
        <path class="diagram__opp-limb" d="M482 288 L500 320 L520 330" />

        <text x="320" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="470" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="300" y="110" class="diagram__label diagram__label--accent">
          PUTAR 360
        </text>
      </svg>
    )
  }

  {
    frame === 3 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          03 / KONTAK DAN MENJAUH
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK ATAS
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="280" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="256"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M256 240 L210 260 L170 270" />
        <path class="diagram__main-limb" d="M304 240 L350 260 L390 270" />
        <path class="diagram__main-limb" d="M268 288 L250 320 L230 330" />
        <path class="diagram__main-limb" d="M292 288 L310 320 L330 330" />

        <circle class="diagram__opp" cx="420" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="396"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M396 240 L350 260 L310 270" />
        <path class="diagram__opp-limb" d="M444 240 L490 260 L530 270" />
        <path class="diagram__opp-limb" d="M408 288 L390 320 L370 330" />
        <path class="diagram__opp-limb" d="M432 288 L450 320 L470 330" />

        <text x="280" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="420" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="350" y="160" class="diagram__label diagram__label--accent">
          MENJAUH
        </text>
      </svg>
    )
  }
</Figure>
