---
import Figure from "../Figure.astro";

interface Props {
  frame: 1 | 2 | 3;
  number: string;
  alt: string;
  caption: string;
}

const { frame, number, alt, caption } = Astro.props;
const titleId = `wristrelease-figure-${frame}`;
---

<Figure number={number} caption={caption}>
  {
    frame === 1 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          01 / CENGKERAMAN
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK SAMPING
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="290" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="266"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M266 240 L220 260 L180 270" />
        <path class="diagram__main-limb" d="M314 240 L360 260 L400 270" />
        <path class="diagram__main-limb" d="M278 288 L260 320 L240 330" />
        <path class="diagram__main-limb" d="M302 288 L320 320 L340 330" />

        <circle class="diagram__opp" cx="470" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="446"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M446 240 L400 260 L360 270" />
        <path class="diagram__opp-limb" d="M494 240 L540 260 L580 270" />
        <path class="diagram__opp-limb" d="M458 288 L440 320 L420 330" />
        <path class="diagram__opp-limb" d="M482 288 L500 320 L520 330" />

        <path
          class="diagram__arrow"
          d="M446 240 C400 220 360 200 314 200"
          marker-end={`url(#wristrelease-arrow-${frame})`}
        />
        <defs>
          <marker
            id={`wristrelease-arrow-${frame}`}
            viewBox="0 0 6 6"
            refX="5"
            refY="3"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
            markerUnits="strokeWidth"
          >
            <path class="diagram__arrow-head" d="M0 0 L6 3 L0 6 Z" />
          </marker>
        </defs>

        <text x="290" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="470" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="390" y="160" class="diagram__label diagram__label--accent">
          CENGKERAM
        </text>
      </svg>
    )
  }

  {
    frame === 2 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          02 / PUTAR DAN TARIK
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK SAMPING
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="300" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="276"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M276 240 L230 260 L190 270" />
        <path class="diagram__main-limb" d="M324 230 L380 200 L440 180" />
        <path class="diagram__main-limb" d="M288 288 L270 320 L250 330" />
        <path class="diagram__main-limb" d="M312 288 L330 320 L350 330" />

        <circle class="diagram__opp" cx="470" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="446"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M446 240 L400 260 L360 270" />
        <path class="diagram__opp-limb" d="M494 240 L540 260 L580 270" />
        <path class="diagram__opp-limb" d="M458 288 L440 320 L420 330" />
        <path class="diagram__opp-limb" d="M482 288 L500 320 L520 330" />

        <path
          class="diagram__arrow"
          d="M324 200 C360 160 400 150 440 180"
          marker-end={`url(#wristrelease-arrow-${frame})`}
        />
        <defs>
          <marker
            id={`wristrelease-arrow-${frame}`}
            viewBox="0 0 6 6"
            refX="5"
            refY="3"
            markerWidth="6"
            markerHeight="6"
            orient="auto"
            markerUnits="strokeWidth"
          >
            <path class="diagram__arrow-head" d="M0 0 L6 3 L0 6 Z" />
          </marker>
        </defs>

        <text x="300" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="470" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="380" y="130" class="diagram__label diagram__label--accent">
          PUTAR
        </text>
      </svg>
    )
  }

  {
    frame === 3 && (
      <svg
        class="diagram"
        viewBox="0 0 720 400"
        role="img"
        aria-labelledby={titleId}
      >
        <title id={titleId}>{alt}</title>
        <text x="40" y="28" class="diagram__note">
          03 / LEPAS DAN MENJAUH
        </text>
        <text x="680" y="28" class="diagram__note" text-anchor="end">
          TAMPAK SAMPING
        </text>
        <line x1="40" y1="44" x2="680" y2="44" class="diagram__tick" />
        <line x1="40" y1="330" x2="680" y2="330" class="diagram__ground" />

        <circle class="diagram__main" cx="240" cy="200" r="24" />
        <rect
          class="diagram__main"
          x="216"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__main-limb" d="M216 240 L170 260 L130 270" />
        <path class="diagram__main-limb" d="M264 240 L310 260 L350 270" />
        <path class="diagram__main-limb" d="M228 288 L210 320 L190 330" />
        <path class="diagram__main-limb" d="M252 288 L270 320 L290 330" />

        <circle class="diagram__opp" cx="470" cy="200" r="24" />
        <rect
          class="diagram__opp"
          x="446"
          y="224"
          width="48"
          height="64"
          rx="10"
        />
        <path class="diagram__opp-limb" d="M446 240 L400 260 L360 270" />
        <path class="diagram__opp-limb" d="M494 240 L540 260 L580 270" />
        <path class="diagram__opp-limb" d="M458 288 L440 320 L420 330" />
        <path class="diagram__opp-limb" d="M482 288 L500 320 L520 330" />

        <text x="240" y="372" class="diagram__label" text-anchor="middle">
          ANDA
        </text>
        <text x="470" y="372" class="diagram__label" text-anchor="middle">
          LAWAN
        </text>
        <text x="40" y="352" class="diagram__note">
          MATRAS
        </text>
        <text x="355" y="240" class="diagram__label diagram__label--accent">
          MENJAUH
        </text>
      </svg>
    )
  }
</Figure>
