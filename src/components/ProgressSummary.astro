---
interface Props {
  slugs: string[];
}

const { slugs } = Astro.props;
---

<div
  class="progress-summary"
  data-progress-summary
  data-slugs={slugs.join(" ")}
>
  <p class="label">Progres latihan</p>
  <p class="progress-summary__count">
    <strong data-progress-count>0</strong>
    <span>dari {slugs.length} teknik ditandai</span>
  </p>
  <p class="progress-summary__note" data-progress-note>
    Belum ada teknik yang ditandai di perangkat ini.
  </p>
</div>

<script>
  import { PROGRESS_KEY, countTrained } from "../scripts/progress";

  document
    .querySelectorAll<HTMLElement>("[data-progress-summary]")
    .forEach((root) => {
      const slugs = (root.dataset.slugs ?? "")
        .split(/\s+/)
        .filter(Boolean);
      const count = root.querySelector<HTMLElement>("[data-progress-count]");
      const note = root.querySelector<HTMLElement>("[data-progress-note]");
      if (!count || !note) return;

      const update = () => {
        const trained = countTrained(slugs);
        count.textContent = String(trained);
        note.textContent =
          trained === 0
            ? "Belum ada teknik yang ditandai di perangkat ini."
            : `${trained} dari ${slugs.length} teknik sudah ditandai.`;
      };

      update();
      window.addEventListener("tahan:progress-change", update);
      window.addEventListener("storage", (event) => {
        if (event.key === PROGRESS_KEY) update();
      });
    });
</script>

<style>
  .progress-summary {
    margin-bottom: clamp(28px, 4vw, 40px);
    padding: 16px 18px;
    border-left: 2px solid var(--accent);
    background: var(--paper-2);
  }

  .progress-summary .label {
    color: var(--accent-dark);
  }

  .progress-summary__count {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px;
    margin: 6px 0 0;
    font-size: 0.9375rem;
  }

  .progress-summary__count strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 600;
    line-height: 1;
  }

  .progress-summary__note {
    margin: 4px 0 0;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
