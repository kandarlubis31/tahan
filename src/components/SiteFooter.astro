---
import { isActivePath } from "../scripts/nav";

const path = Astro.url.pathname;
const links = [
  { href: "/panduan", label: "Panduan" },
  { href: "/panduan/04-tanah", label: "Bab 04 · Tanah" },
  { href: "/teknik", label: "Indeks teknik" },
  { href: "/katalog", label: "Katalog" },
  { href: "/kuncian", label: "Kuncian" },
  { href: "/sumber", label: "Sumber" },
  { href: "/tentang", label: "Tentang" },
];

// Hanya satu tautan yang boleh bertanda aktif. `/panduan` juga cocok untuk
// setiap bab, jadi yang dipakai adalah kecocokan paling spesifik.
const match = links
  .filter((link) => isActivePath(path, link.href))
  .sort((a, b) => b.href.length - a.href.length)[0];
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <p class="footer-word">TAHAN</p>
        <p class="footer-tagline">
          Bela diri bukan soal menang. Soal pulang utuh.
        </p>
      </div>
      <nav class="footer-nav" aria-label="Navigasi footer">
        {
          links.map((link) => (
            <a
              href={link.href}
              aria-current={match?.href === link.href ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
        <button class="footer-print" type="button" data-print>Cetak</button>
      </nav>
      <div class="footer-meta">
        <span class="label">Edisi 1.0.0</span>
        <span class="label">2026</span>
        <span class="label">Bahasa Indonesia</span>
      </div>
    </div>

    <div class="footer-disclaimer">
      <p>
        <strong>Batas:</strong> Situs ini bukan pengganti pelatih. Teknik
        berpasangan hanya di matras dan dengan pengawasan. Tidak ada tutorial
        melumpuhkan atau melepas senjata tajam. Situs ini bukan nasihat hukum.
      </p>
    </div>

    <div class="footer-bottom">
      <span class="label">TAHAN · Panduan bertahan diri</span>
      <span class="label">Dibaca sebelum dibutuhkan</span>
    </div>
  </div>
</footer>
