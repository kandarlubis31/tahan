---
const path = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === "/") return path === "/";
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="TAHAN — beranda">
      <span class="brand__mark" aria-hidden="true"></span>
      <span class="brand__word">TAHAN</span>
      <span class="brand__tag">Panduan bertahan diri</span>
    </a>
    <nav class="site-nav" aria-label="Navigasi utama">
      <a href="/panduan" aria-current={isActive("/panduan") ? "page" : undefined}>
        Panduan
      </a>
      <a href="/aliran" aria-current={isActive("/aliran") ? "page" : undefined}>
        Aliran
      </a>
      <a href="/latihan" aria-current={isActive("/latihan") ? "page" : undefined}>
        Latihan
      </a>
      <a href="/glosarium" aria-current={isActive("/glosarium") ? "page" : undefined}>
        Glosarium
      </a>
      <a href="/tentang" aria-current={isActive("/tentang") ? "page" : undefined}>
        Tentang
      </a>
    </nav>
  </div>
</header>
